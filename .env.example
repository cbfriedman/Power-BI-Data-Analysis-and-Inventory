# =============================================================================
# Purchasing & Replenishment Management System — example environment
# =============================================================================
# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
# Every value here is a NON-SECRET local development placeholder. Real
# credentials are supplied through the environment in every other context and
# are never written to a file in this repository (CLAUDE.md §4).
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=prms
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=prms
POSTGRES_PORT=5432

# Host port the database is published on. Change if 5432 is already in use.
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
APP_ENV=local
APP_NAME=prms-api
LOG_LEVEL=INFO

# Set to "console" for human-readable local logs; "json" for structured output.
LOG_FORMAT=json

# SQLAlchemy URL. Inside Compose the host is the service name "postgres".
# Running the API on the host instead, use: @localhost:5432
DATABASE_URL=postgresql+psycopg://prms:local_dev_only_change_me@postgres:5432/prms

# Host port the API is published on.
API_HOST_PORT=8000

# Comma-separated list of origins permitted by CORS.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Return the exception type and message on unhandled errors. Development only;
# the application refuses to start in production with this enabled.
EXPOSE_ERROR_DETAILS=false

# -----------------------------------------------------------------------------
# Authentication (development)
# -----------------------------------------------------------------------------
# HS256 signing key for locally issued development tokens. THIS PLACEHOLDER IS
# RECOGNISED BY NAME and the application refuses to start in production with it.
# Generate a real one per environment:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=insecure-development-signing-key-change-me

# Enables POST /api/v1/auth/dev-token, which issues a token for any existing
# active user WITHOUT a password. Never enable this outside local development;
# production start-up refuses it outright. See docs/security.md.
DEV_AUTH_ENABLED=true

AUTH_TOKEN_TTL_MINUTES=480
AUTH_ISSUER=prms-dev
AUTH_AUDIENCE=prms-api

# -----------------------------------------------------------------------------
# Nineyard
# -----------------------------------------------------------------------------
# Authentication is email + password + companyId, exchanged for a bearer token
# at POST /api/OAuth/UsernameToken. There is no API key.
#
# Leave these unset and the read-only probe refuses to run rather than guessing.
# The probe never prints or logs the email, the password, or the token.
NINEYARD_BASE_URL=https://backyard.nineyard.com
# NINEYARD_EMAIL=you@example.com
# NINEYARD_PASSWORD=your-nineyard-password
# NINEYARD_COMPANY_ID=1234

NINEYARD_TIMEOUT_SECONDS=30
# Attempts per request. Retries apply to transient failures only (429, 5xx,
# connection errors) - never to a 401, 403 or 404.
NINEYARD_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Storage — retained import files (ADR 0004)
# -----------------------------------------------------------------------------
# Paths as seen from inside the container. Compose bind-mounts ./storage here.
STORAGE_RAW_DIR=/storage/raw
STORAGE_PROCESSED_DIR=/storage/processed
STORAGE_REJECTED_DIR=/storage/rejected

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Baked into the browser bundle at build time — must be reachable from the
# BROWSER, not from inside the Docker network. Never put a secret in a
# NEXT_PUBLIC_* variable.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Host port the web app is published on.
WEB_HOST_PORT=3000
